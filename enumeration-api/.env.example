# MongoDB Connection Configuration
# The connection URL for MongoDB database
# Format: mongodb://username:password@host:port
MONGODB_URL=mongodb://root:example@mongodb:27017

# MongoDB Database Name
# The name of the database to use for SKU data
MONGODB_DATABASE=enumeration_db

# Service Configuration
# The name of this service for logging and tracing
SERVICE_NAME=enumeration-api

# Jaeger Tracing Configuration
# The endpoint for exporting traces to Jaeger
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
